{
  "manifest_version": 3,
  "name": "ContextClip: LLM-Ready Web Markdown Clipper",
  "version": "1.0.1",
  "description": "Copy webpage content as clean Markdown for ChatGPT, Claude, Cursor and Gemini. Includes preview and token estimates.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ContextClip - Copy Clean Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "commands": {
    "copy-clean-markdown": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Extract & copy clean LLM Markdown to clipboard"
    }
  }
}
